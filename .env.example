# Local Docker Compose settings. Copy this file to .env and replace the password.
POSTGRES_HOST=localhost
POSTGRES_DB=resolvex
POSTGRES_USER=resolvex
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432
APP_PORT=8083

# JWT values used by the application. Set JWT_SECRET to a cryptographically random value.
JWT_SECRET=replace-with-a-cryptographically-random-32-byte-or-longer-secret
JWT_ISSUER=resolvex-api
JWT_EXPIRATION_MINUTES=30

# One-time first-administrator bootstrap. Keep disabled after the first ADMIN exists.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_NAME=ResolveX Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@resolvex.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password
